post_install() {
    echo "==> Open Sweeflow from your app menu (or run: sweeflow open) to set it up for your user and link a Mac."
}
post_upgrade() {
    # The per-user service runs /usr/bin/sweeflow: restart it in each session so the new version runs.
    for bus in /run/user/*/bus; do
        [ -S "$bus" ] || continue
        uid=$(basename "$(dirname "$bus")")
        user=$(id -nu "$uid" 2>/dev/null) || continue
        runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            systemctl --user try-restart sweeflow.service 2>/dev/null || true
    done
}
pre_remove() {
    echo "==> Sweeflow takes its service, launchers and shortcuts away by itself within a minute. Your settings stay in ~/.config/sweeflow."
}
