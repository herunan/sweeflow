# Maintainer: Hernán Romero <herunan at users dot noreply dot github dot com>
# Built from source against Arch's FFmpeg. (The Mac app is its own download, from the website.)
pkgname=sweeflow
pkgver=0.1.0
pkgrel=1
pkgdesc='Mac apps as windows on a Linux desktop'
arch=('x86_64')
url='https://github.com/herunan/sweeflow'
license=('MIT')
depends=('glibc' 'gcc-libs' 'ffmpeg' 'libva' 'libdrm' 'libxkbcommon' 'fontconfig' 'freetype2' 'systemd')
makedepends=('cargo' 'clang' 'pkgconf' 'cargo-about' 'python')
optdepends=('pipewire-audio: the Mac'"'"'s sound (pw-cat)'
            'libpulse: the Mac'"'"'s sound on PulseAudio (pacat)'
            'libnotify: notifications (notify-send)')
install=sweeflow.install
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver/linux"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver/linux"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo build --frozen --release
    ./licenses.sh
}

check() {
    cd "$pkgname-$pkgver/linux"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 linux/target/release/sweeflow "$pkgdir/usr/bin/sweeflow"
    install -Dm644 linux/packaging/sweeflow.desktop "$pkgdir/usr/share/applications/sweeflow.desktop"
    install -Dm644 assets/sweeflow-app.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/sweeflow.svg"
    install -Dm644 linux/target/THIRD-PARTY-LICENSES.html "$pkgdir/usr/share/doc/sweeflow/THIRD-PARTY-LICENSES.html"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
